# Copy this file to .env and fill in your values, then restart the server.
#
# Put real credentials in .env, never in this file - .env is gitignored,
# .env.example is not and is meant to be committed as a blank template.

# SkyCiv API credentials, for one-click "Open in CloudCAD".
# Get both from https://platform.skyciv.com/api
# The username is your SkyCiv account email. The key is a long alphanumeric
# string - if yours looks short, it was probably truncated on the way in.
#
# SKYCIV_USERNAME also identifies you for the "My Templates" personal folder.
SKYCIV_USERNAME=wilross.papaya@skyciv.com
SKYCIV_KEY=aR68g4K6PjyJ1WZUcitOY5esXIpauyLnnQXYXuigVOHNAhMI5wHipbxTfx5qe5EZ

# Folder scanned for the shared, curated .dxf templates (read-only).
# Defaults to the folder holding this project, which is where the sample
# templates sit during local testing.
# QUICKDRAW_TEMPLATE_DIR=C:\path\to\shared\templates

# Root folder for per-user personal templates. Each user gets a subfolder.
# Defaults to personal-templates/ inside the project.
# QUICKDRAW_PERSONAL_DIR=C:\path\to\personal\templates
